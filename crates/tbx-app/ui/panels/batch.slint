import { Button, ComboBox, GroupBox, LineEdit, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { L10n, BatchApi } from "../globals.slint";
import { ProBadge, Divider } from "../widgets.slint";
component LockNote inherits Text {
    in property <string> note;
    text: note;
    font-size: 10px;
    color: #b45309;
    wrap: word-wrap;
}
component ChainRow inherits Rectangle {
    in property <string> label;
    in property <int>    index;
    in property <int>    kind: -1;
    height: 34px;
    border-radius: 6px;
    background: BatchApi.selected-step == index
        ? #e0f2fe
        : touch.has-hover ? #f1f5f9
        : transparent;
    animate background { duration: 80ms; }
    Rectangle {
        x: 0; y: 4px;
        width: 3px;
        height: parent.height - 8px;
        border-radius: 2px;
        background: kind == 0 ? #0d9488
                  : kind == 1 ? #7c3aed
                  : kind == 2 ? #d97706
                  : kind == 3 ? #2563eb
                  : #94a3b8;
    }
    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { BatchApi.select-step(index); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: label;
            font-size: 12px;
            color: BatchApi.selected-step == index ? #0369a1 : #0f172a;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: 80ms; }
        }
    }
}
component LogLine inherits Rectangle {
    in property <string> line;
    in property <int>    level: 0;
    height: line-text.preferred-height + 4px;
    line-text := Text {
        text: line;
        font-size: 11px;
        color: level == 1 ? #15803d
             : level == 3 ? #b91c1c
             : level == 2 ? #92400e
             : #475569;
        wrap: word-wrap;
        x: 0; y: 2px;
        width: parent.width;
    }
}
export component BatchPanel inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: L10n.batch-title;
                font-size: 20px;
                font-weight: 700;
                color: #0f172a;
            }
            Text {
                text: L10n.batch-subtitle;
                font-size: 12px;
                color: #64748b;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if BatchApi.running : Text {
                text: round(BatchApi.progress * 100) + "%";
                font-size: 13px;
                font-weight: 700;
                color: #0369a1;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            left-scroll := ScrollView {
                width: 420px;
                opacity: BatchApi.running ? 0.6 : 1.0;
                animate opacity { duration: 200ms; }
                VerticalLayout {
                    spacing: 10px;
                    width: left-scroll.visible-width;
                    GroupBox {
                        title: L10n.batch-chain-section;
                        VerticalLayout {
                            spacing: 6px;
                            if BatchApi.steps.length == 0 : Text {
                                text: L10n.batch-chain-empty;
                                font-size: 12px;
                                color: #64748b;
                                wrap: word-wrap;
                            }
                            for step[index] in BatchApi.steps : ChainRow {
                                label: step;
                                index: index;
                            }
                            Divider {}
                            HorizontalLayout {
                                spacing: 6px;
                                ComboBox {
                                    width: 220px;
                                    model: [
                                        L10n.batch-step-tileable,
                                        L10n.batch-step-maps,
                                        L10n.batch-step-pack,
                                        L10n.batch-step-optimize,
                                    ];
                                    current-index <=> BatchApi.add-kind;
                                    enabled: !BatchApi.chain-full && !BatchApi.running;
                                }
                                Button {
                                    text: L10n.batch-add;
                                    enabled: !BatchApi.chain-full && !BatchApi.running;
                                    clicked => { BatchApi.add-step(); }
                                }
                            }
                            if BatchApi.lock-chain : HorizontalLayout {
                                spacing: 6px;
                                ProBadge { locked: true; }
                                LockNote { note: L10n.batch-locked-chain; horizontal-stretch: 1; }
                            }
                            if BatchApi.lock-pack-step : HorizontalLayout {
                                spacing: 6px;
                                ProBadge { locked: true; }
                                LockNote { note: L10n.batch-locked-pack-step; horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: L10n.batch-remove;
                                    enabled: BatchApi.selected-step >= 0 && !BatchApi.running;
                                    clicked => { BatchApi.remove-step(); }
                                }
                                Button {
                                    text: L10n.batch-up;
                                    enabled: BatchApi.selected-step > 0 && !BatchApi.lock-chain && !BatchApi.running;
                                    clicked => { BatchApi.move-selected(-1); }
                                }
                                Button {
                                    text: L10n.batch-down;
                                    enabled: BatchApi.selected-step >= 0
                                        && BatchApi.selected-step < BatchApi.steps.length - 1
                                        && !BatchApi.lock-chain && !BatchApi.running;
                                    clicked => { BatchApi.move-selected(1); }
                                }
                            }
                        }
                    }
                    GroupBox {
                        title: L10n.batch-params-section;
                        VerticalLayout {
                            spacing: 6px;
                            if BatchApi.selected-step < 0 : Text {
                                text: L10n.batch-params-none;
                                font-size: 12px;
                                color: #64748b;
                                wrap: word-wrap;
                            }
                            if BatchApi.selected-kind == 0 : ComboBox {
                                model: [L10n.batch-mode-offset, L10n.batch-mode-mirror];
                                current-index <=> BatchApi.tileable-mode;
                                enabled: !BatchApi.running;
                                selected => { BatchApi.update-tileable(); }
                            }
                            if BatchApi.selected-kind == 1 : Text {
                                text: L10n.batch-params-maps-note;
                                font-size: 11px;
                                color: #475569;
                                wrap: word-wrap;
                            }
                            if BatchApi.selected-kind == 2 : ComboBox {
                                model: [L10n.pack-preset-unreal, L10n.pack-preset-unity, L10n.pack-preset-godot];
                                current-index <=> BatchApi.pack-preset;
                                enabled: !BatchApi.running;
                                selected => { BatchApi.update-pack(); }
                            }
                            if BatchApi.selected-kind == 3 : VerticalLayout {
                                spacing: 6px;
                                ComboBox {
                                    model: [
                                        L10n.optimize-size-original,
                                        L10n.optimize-size-64,
                                        L10n.optimize-size-128,
                                        L10n.optimize-size-256,
                                        L10n.optimize-size-512,
                                        L10n.optimize-size-1024,
                                        L10n.optimize-size-2048,
                                        L10n.optimize-size-4096,
                                    ];
                                    current-index <=> BatchApi.opt-size;
                                    enabled: !BatchApi.running;
                                    selected => { BatchApi.update-opt(); }
                                }
                                ComboBox {
                                    model: [L10n.optimize-format-png, L10n.optimize-format-tga, L10n.optimize-format-dds];
                                    current-index <=> BatchApi.opt-format;
                                    enabled: !BatchApi.running;
                                    selected => { BatchApi.update-opt(); }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    ComboBox {
                                        width: 220px;
                                        model: [L10n.optimize-bc-1, L10n.optimize-bc-3, L10n.optimize-bc-5, L10n.optimize-bc-7];
                                        current-index <=> BatchApi.opt-bc;
                                        enabled: !BatchApi.running && BatchApi.opt-format == 2;
                                        selected => { BatchApi.update-opt(); }
                                    }
                                    if BatchApi.lock-dds && BatchApi.opt-format == 2 : HorizontalLayout {
                                        spacing: 6px;
                                        ProBadge { locked: true; }
                                        LockNote { note: L10n.optimize-locked-dds; horizontal-stretch: 1; }
                                    }
                                }
                            }
                        }
                    }
                    GroupBox {
                        title: L10n.batch-folders-section;
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: L10n.batch-input-folder;
                                    font-size: 11px;
                                    color: #475569;
                                    vertical-alignment: center;
                                    width: 90px;
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: BatchApi.input-folder;
                                    enabled: false;
                                    font-size: 11px;
                                }
                                Button {
                                    text: L10n.batch-browse;
                                    enabled: !BatchApi.running;
                                    clicked => { BatchApi.browse-input(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: L10n.batch-output-folder;
                                    font-size: 11px;
                                    color: #475569;
                                    vertical-alignment: center;
                                    width: 90px;
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: BatchApi.output-folder;
                                    enabled: false;
                                    font-size: 11px;
                                }
                                Button {
                                    text: L10n.batch-browse;
                                    enabled: !BatchApi.running;
                                    clicked => { BatchApi.browse-output(); }
                                }
                            }
                            if BatchApi.files-label != "" : Text {
                                text: BatchApi.files-label;
                                font-size: 11px;
                                color: #0369a1;
                                wrap: word-wrap;
                            }
                            if BatchApi.lock-files : HorizontalLayout {
                                spacing: 6px;
                                ProBadge { locked: true; }
                                LockNote { note: L10n.batch-locked-files; horizontal-stretch: 1; }
                            }
                        }
                    }
                    GroupBox {
                        title: L10n.batch-run-section;
                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: L10n.batch-dry-run;
                                    enabled: !BatchApi.lock-dry-run && !BatchApi.running;
                                    clicked => { BatchApi.dry-run(); }
                                }
                                Button {
                                    text: BatchApi.files-label != ""
                                        ? L10n.batch-run + "  ▶"
                                        : L10n.batch-run;
                                    primary: !BatchApi.running;
                                    enabled: !BatchApi.running;
                                    clicked => { BatchApi.run-batch(); }
                                }
                            }
                            if BatchApi.running : VerticalLayout {
                                spacing: 4px;
                                ProgressIndicator {
                                    height: 8px;
                                    progress: BatchApi.progress;
                                }
                                Text {
                                    text: BatchApi.status;
                                    font-size: 11px;
                                    color: #0369a1;
                                    wrap: word-wrap;
                                }
                            }
                            if BatchApi.lock-dry-run : HorizontalLayout {
                                spacing: 6px;
                                ProBadge { locked: true; }
                                LockNote { note: L10n.batch-locked-dry-run; horizontal-stretch: 1; }
                            }
                            if BatchApi.lock-parallel : HorizontalLayout {
                                spacing: 6px;
                                ProBadge { locked: true; }
                                LockNote { note: L10n.batch-locked-parallel; horizontal-stretch: 1; }
                            }
                            if !BatchApi.running && BatchApi.status != "" : Text {
                                text: BatchApi.status;
                                font-size: 11px;
                                color: #0369a1;
                                wrap: word-wrap;
                            }
                            Text {
                                text: L10n.batch-hint;
                                font-size: 10px;
                                color: #94a3b8;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            log-scroll := ScrollView {
                horizontal-stretch: 1;
                GroupBox {
                    title: L10n.batch-log-section;
                    width: log-scroll.visible-width;
                    VerticalLayout {
                        spacing: 3px;
                        if BatchApi.log.length == 0 : Text {
                            text: L10n.batch-log-empty;
                            font-size: 12px;
                            color: #64748b;
                        }
                        for entry in BatchApi.log : LogLine {
                            line: entry.text;
                            level: entry.level;
                        }
                    }
                }
            }
        }
    }
}
