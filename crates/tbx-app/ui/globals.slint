    label: string,
    feature: string,
}
export global PreviewApi {
    in-out property <int> geometry: 0;
    in-out property <bool> lock-sphere: true;
    in-out property <bool> lock-lighting: true;
    in-out property <int> lighting-index: 0;
    in-out property <[Warning]> warnings;
    in-out property <bool> has-warnings: false;
    in-out property <image> preview;
    in-out property <bool> has-preview: false;
    in-out property <bool> busy: false;
    in-out property <string> status;
    callback select-geometry(int);
    callback select-lighting(int);
    callback refresh;
    callback zoom-view(float);
    callback drag-view(float, float);
}
export global BatchApi {
    in-out property <[string]> steps;
    in-out property <int> selected-step: -1;
    in-out property <int> selected-kind: -1;
    in-out property <bool> lock-chain: true;
    in-out property <bool> lock-files: true;
    in-out property <bool> lock-dry-run: true;
    in-out property <bool> lock-parallel: true;
    in-out property <bool> lock-pack-step: true;
    in-out property <bool> lock-dds: true;
    in-out property <bool> chain-full: false;
    in-out property <string> input-folder;
    in-out property <string> output-folder;
    in-out property <string> files-label;
    in-out property <bool> running: false;
    in-out property <float> progress: 0.0;
    in-out property <string> status;
    in-out property <[BatchLogLine]> log;
    in-out property <int> tileable-mode: 0;
    in-out property <int> pack-preset: 0;
    in-out property <int> opt-size: 0;
    in-out property <int> opt-format: 0;
    in-out property <int> opt-bc: 0;
    in-out property <int> add-kind: 0;
    callback add-step;
    callback select-step(int);
    callback remove-step;
    callback move-selected(int);
    callback browse-input;
    callback browse-output;
    callback update-tileable;
    callback update-pack;
    callback update-opt;
    callback dry-run;
    callback run-batch;
    callback reload;
}
export global PresetsApi {
    in-out property <[PresetEntry]> preset-list;
    in-out property <int> selected: -1;
    in-out property <string> preset-name;
    in-out property <int> save-feature: 0;
    in-out property <bool> lock-unlimited: true;
    in-out property <bool> lock-export: true;
    in-out property <string> status;
    callback save-preset;
    callback apply-preset;
    callback delete-preset;
    callback select-preset(int);
    callback export-preset;
    callback import-preset;
}
